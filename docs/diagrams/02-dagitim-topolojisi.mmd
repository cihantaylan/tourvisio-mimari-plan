    BR -->|"HTTPS"| CF
    MOB -.->|"api.gidiyorum.com"| CF
    CF --> TRF --> NX
    NX ==>|"iç overlay (IPsec), HTTP + JWT"| GWY
    TRF -.->|"api.gidiyorum.com"| GWY
